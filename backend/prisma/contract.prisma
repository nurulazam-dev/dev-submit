// use prisma-8
model User {
  id                String       @id @default(uuid())
  name              String
  email             String       @unique
  password          String
  role              UserRole     @default(STUDENT)
  status            UserStatus   @default(ACTIVE)
  phone             String       @unique
  address           String?
  passwordChangedAt DateTime?
  resetOtpHash      String?
  resetOtpExpiresAt DateTime?
  submissions       Submission[]
  reviews           Review[]
  createdAt         DateTime     @default(now())

  @@index([role])
  @@index([status])
  @@map("user")
}

model Submission {
  id          String           @id @default(uuid())
  title       String
  description String
  githubUrl   String
  liveUrl     String
  status      SubmissionStatus @default(PENDING)
  studentId   String
  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // review      Review[]
  review      Review?

  createdAt   DateTime         @default(now())

  @@index([studentId])
  @@index([status])

  @@index([githubUrl], unique: true, name: "submission_github_url_unique")

  @@index([studentId], unique: true, where: sql`("status" = 'PENDING')`, name: "one_pending_submission_per_student")

  @@map("submissions")
}

model Review {
  id           String       @id @default(uuid())
  status       ReviewStatus @default(IN_PROGRESS)
  feedback     String
  submissionId String       @unique
  submission   Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User         @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  createdAt    DateTime     @default(now())

  @@index([reviewerId])
  @@index([submissionId])
  @@index([status])

  @@map("reviews")
}

enum UserRole {
  ADMIN
  STUDENT
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewStatus {
  IN_PROGRESS
  COMPLETED
}
